# Copy to .env. Nothing here is secret; HF auth uses the token stored by `hf auth login`.
# Hugging Face dataset that holds the pipeline inputs (inputs/) and results (results/).
NEUROTOPO_HF_DATASET=BurnyCoder/topology-of-neural-geometry
# Maintainer-only: local copy of the source project used by scripts/export_source_artifacts.py.
# Defaults to the git submodule; set it to a folder that also contains data_cache/ and results/main_s0/synth/.
NEUROTOPO_SOURCE_DIR=external/shape-fitting
# Maintainer-only: python interpreter of the source project's venv (has torch, needed by the export script).
NEUROTOPO_SOURCE_PYTHON=external/shape-fitting/.venv/Scripts/python.exe
